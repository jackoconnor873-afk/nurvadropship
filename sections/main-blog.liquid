<div class="section">
  <div class="wrap wrap--wide">
    <div class="sec-head stack" data-reveal>
      <span class="eyebrow">Journal</span>
      <h1 class="h1">{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by 12 -%}
      <div class="grid grid--3 reveal-stagger">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}">
            <div class="card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title, sizes: '(min-width:750px) 33vw, 90vw', widths: '300,500,800' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="quote__meta">{{ article.published_at | date: '%B %d, %Y' }}</div>
            <div class="card__title">{{ article.title }}</div>
            <p class="muted" style="font-size:.9rem">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{ "name": "Blog", "tag": "section", "settings": [] }
{% endschema %}
