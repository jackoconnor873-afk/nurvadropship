<div class="section {% if section.settings.raised %}section--raised{% endif %}">
  <div class="wrap wrap--narrow">
    <div class="sec-head sec-head--center stack" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    <div class="faq" data-faq data-faq-single="{{ section.settings.single_open }}" data-reveal>
      {%- for block in section.blocks -%}
        <div class="faq__item" data-open="false" {{ block.shopify_attributes }}>
          <h3>
            <button class="faq__q" type="button" aria-expanded="false" aria-controls="faq-{{ block.id }}">
              <span>{{ block.settings.question }}</span>
              <span class="faq__sign" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="faq__a" id="faq-{{ block.id }}">
            <div>
              <div class="rte">{{ block.settings.answer }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.contact_text != blank -%}
      <p class="center muted" style="margin-top:34px">
        {{ section.settings.contact_text }}
        {%- if section.settings.contact_link != blank -%}
          <a class="tint" href="{{ section.settings.contact_link }}">{{ section.settings.contact_label }}</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "checkbox", "id": "single_open", "label": "Only one answer open at a time", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "contact_text", "label": "Contact line", "default": "Still unsure?" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Talk to us." },
    { "type": "url", "id": "contact_link", "label": "Contact link" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will it stay on while I train?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. Nurva uses a sweat-resistant medical-grade adhesive rated for up to 10 hours of wear, including high-output training and humid conditions.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "Will it stay on while I train?", "answer": "<p>Yes. Nurva uses a sweat-resistant medical-grade adhesive rated for up to 10 hours of wear, including high-output training and humid conditions. Apply to clean, dry skin — oils and moisturiser are the main reason any strip lifts early.</p>" } },
        { "type": "qa", "settings": { "question": "Does it actually help with snoring?", "answer": "<p>It helps when your snoring is driven by nasal congestion or a narrow nasal valve, which covers a large share of people. It is not a treatment for obstructive sleep apnoea. If you snore heavily, stop breathing in your sleep, or wake unrefreshed most mornings, please speak to a doctor.</p>" } },
        { "type": "qa", "settings": { "question": "Is there anything in it? Drugs, menthol, medication?", "answer": "<p>No. Nurva is a purely mechanical, drug-free external nasal dilator. Nothing is absorbed, inhaled or ingested — the strip simply lifts the sides of your nose open from the outside.</p>" } },
        { "type": "qa", "settings": { "question": "What size should I get?", "answer": "<p>One size fits most adult noses. If you have a smaller nose or you're buying for a teenager, place the strip slightly higher on the bridge for a comfortable fit.</p>" } },
        { "type": "qa", "settings": { "question": "Can I reuse a strip?", "answer": "<p>No — each strip is single use. The adhesive and the spring tension are designed to perform once, for up to 10 hours.</p>" } },
        { "type": "qa", "settings": { "question": "Will it irritate sensitive skin?", "answer": "<p>The adhesive is hypoallergenic and latex free. If your skin is very sensitive, remove the strip under warm water — the adhesive softens and releases without pulling.</p>" } },
        { "type": "qa", "settings": { "question": "How fast is shipping, and what if it doesn't work for me?", "answer": "<p>Orders ship within one business day with tracking. If Nurva doesn't make a difference for you, tell us within 30 nights and we'll refund you — you don't need to send the pack back.</p>" } }
      ]
    }
  ]
}
{% endschema %}
