<div class="section section--tight">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="sec-head sec-head--center stack" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="stats" data-reveal="scale">
      {%- for block in section.blocks -%}
        <div class="stat" {{ block.shopify_attributes }}>
          <div class="stat__value">
            <span
              data-count="{{ block.settings.value }}"
              data-decimals="{{ block.settings.decimals }}"
              data-prefix="{{ block.settings.prefix }}"
              data-suffix="{{ block.settings.suffix }}"></span>
          </div>
          <div class="stat__label">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="center muted" style="margin-top:22px;font-size:.78rem">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Stats band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The numbers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small strip. Measurable difference." },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Figures reflect Nurva customer survey data and published research on external nasal dilators. Individual results vary." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Number", "default": "38" },
        { "type": "text", "id": "prefix", "label": "Prefix" },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
        { "type": "range", "id": "decimals", "label": "Decimal places", "min": 0, "max": 2, "step": 1, "default": 0 },
        { "type": "text", "id": "label", "label": "Label", "default": "More nasal airflow" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats band",
      "blocks": [
        { "type": "stat", "settings": { "value": "38", "suffix": "%", "label": "More nasal airflow" } },
        { "type": "stat", "settings": { "value": "10", "suffix": "hr", "label": "Hold time per strip" } },
        { "type": "stat", "settings": { "value": "4.8", "decimals": 1, "suffix": "/5", "label": "Average rating" } },
        { "type": "stat", "settings": { "value": "2400", "suffix": "+", "label": "Athletes breathing better" } }
      ]
    }
  ]
}
{% endschema %}
