<div class="section">
  <div class="wrap wrap--wide">
    <div class="sec-head stack" data-reveal>
      <span class="eyebrow">Search</span>
      <h1 class="h1">
        {%- if search.performed -%}{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}{%- else -%}Search{%- endif -%}
      </h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="signup" style="margin:0 0 44px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products and articles" aria-label="Search">
      <button type="submit" class="btn">Search</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 20 -%}
        {%- if search.results_count > 0 -%}
          <div class="grid grid--4 reveal-stagger">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a class="card" href="{{ item.url }}">
                  <div class="card__title">{{ item.title }}</div>
                  <p class="muted" style="font-size:.9rem">{{ item.content | strip_html | truncate: 110 }}</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}
                  <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div class="empty-state stack">
            <h2 class="h3">No results for &ldquo;{{ search.terms | escape }}&rdquo;</h2>
            <p class="muted">Try a different word, or browse the full range.</p>
            <div><a class="btn" href="{{ routes.all_products_collection_url }}">Shop all</a></div>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "Search", "tag": "section", "settings": [] }
{% endschema %}
