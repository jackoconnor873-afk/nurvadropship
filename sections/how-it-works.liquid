<div class="section {% if section.settings.raised %}section--raised{% endif %}">
  <div class="wrap">
    <div class="sec-head sec-head--center stack" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    <div class="steps">
      <div class="steps__line" aria-hidden="true"></div>
      <div class="grid grid--{{ section.blocks.size | at_most: 4 }} reveal-stagger">
        {%- for block in section.blocks -%}
          <div class="step stack" {{ block.shopify_attributes }}>
            <div class="step__disc">{{ forloop.index }}</div>
            <h3 class="h3">{{ block.settings.title }}</h3>
            <p class="muted">{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="center" style="margin-top: clamp(38px, 5vw, 62px)" data-reveal>
        <a class="btn btn--lg" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          {{ section.settings.cta_label }}
          {% render 'icon', name: 'arrow-right', size: 16 %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three seconds to apply" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Nurva works" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "No batteries, no refills, no learning curve. Peel, place, breathe." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Clean & dry" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Wash and dry the bridge of your nose so the adhesive grips properly." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Clean & dry", "body": "Wash and dry the bridge of your nose so the adhesive grips properly. No oils, no lotion." } },
        { "type": "step", "settings": { "title": "Peel & place", "body": "Remove the liner and centre the strip just above the flare of your nostrils." } },
        { "type": "step", "settings": { "title": "Press & hold", "body": "Press the ends down for five seconds. The spring bands do the rest." } },
        { "type": "step", "settings": { "title": "Breathe", "body": "Train, race or sleep. Peel off gently under warm water when you're done." } }
      ]
    }
  ]
}
{% endschema %}
