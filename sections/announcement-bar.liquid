<div class="announce" style="background: {{ section.settings.bg }}; color: {{ section.settings.text_color }};">
  <div class="announce__track">
    {%- for block in section.blocks -%}
      <div class="announce__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}
          {% render 'icon', name: block.settings.icon, size: 15 %}
        {%- endif -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          <span>{{ block.settings.text }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#0c7280" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $35" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Shield" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "refresh", "label": "Returns" },
            { "value": "star", "label": "Star" },
            { "value": "leaf", "label": "Leaf" }
          ]
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on orders over $35", "icon": "truck" } },
        { "type": "message", "settings": { "text": "30-night breathe-better guarantee", "icon": "shield" } },
        { "type": "message", "settings": { "text": "Rated 4.8 by 2,400+ athletes", "icon": "star" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
