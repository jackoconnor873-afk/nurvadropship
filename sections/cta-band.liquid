<div class="section">
  <div class="wrap">
    <div class="cta-band stack" data-reveal="scale">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="lede" style="margin-inline:auto">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.settings.show_form -%}
        {%- form 'customer', class: 'signup-wrap' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="signup">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email</label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.placeholder | default: 'you@email.com' }}"
              autocomplete="email"
              required>
            <button type="submit" class="btn">{{ section.settings.button_label | default: 'Get my code' }}</button>
          </div>

          {%- if form.errors -%}
            <p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- elsif form.posted_successfully? -%}
            <p class="form-success">Thanks — check your inbox for the code.</p>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div>
          <a class="btn btn--lg" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
            {{ section.settings.cta_label }}
            {% render 'icon', name: 'arrow-right', size: 16 %}
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="form-note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the movement" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 15% off your first pack" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Training tips, breathing protocols and early access to new drops. No spam — unsubscribe any time." },
    { "type": "checkbox", "id": "show_form", "label": "Show email signup", "default": true },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button_label", "label": "Submit label", "default": "Get my code" },
    { "type": "text", "id": "cta_label", "label": "Button label (instead of form)" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small print", "default": "By subscribing you agree to receive marketing emails from Nurva." }
  ],
  "presets": [{ "name": "CTA band" }]
}
{% endschema %}
