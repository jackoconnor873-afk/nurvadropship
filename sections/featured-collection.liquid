<div class="section {% if section.settings.raised %}section--raised{% endif %}">
  <div class="wrap wrap--wide">
    <div class="sec-head sec-head--split" data-reveal>
      <div class="stack">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="link-arrow" href="{{ section.settings.collection.url }}">
          {{ section.settings.link_label | default: 'View all' }}
          {% render 'icon', name: 'arrow-right', size: 15 %}
        </a>
      {%- endif -%}
    </div>

    {%- assign products = section.settings.collection.products -%}
    {%- if products.size > 0 -%}
      <div class="grid grid--{{ section.settings.columns }} reveal-stagger">
        {%- for product in products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid grid--{{ section.settings.columns }} reveal-stagger">
        {%- for i in (1..section.settings.limit) -%}
          <div class="card">
            <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__title">Nurva Performance Strips</div>
            <div class="card__price"><span>$24.99</span></div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "raised", "label": "Raised background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Nurva" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
