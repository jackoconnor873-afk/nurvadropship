{.nurva .trust-row{grid-template-columns: repeat(1,minmax(0,1fr))}}.nurva .trust-row div{display: flex;align-items: center;gap: 10px;font-size: 0.8rem;color: var(--text-muted)}.nurva .trust-row svg{flex: none;color: var(--teal-bright)}.nurva [data-reveal]{opacity: 0;transform: translateY(26px);transition: opacity 0.85s var(--ease) var(--reveal-delay,0s),transform 0.85s var(--ease) var(--reveal-delay,0s);will-change: opacity,transform}.nurva [data-reveal="left"]{transform: translateX(-30px)}.nurva [data-reveal="right"]{transform: translateX(30px)}.nurva [data-reveal="scale"]{transform: scale(0.95)}.nurva [data-reveal].is-in{opacity: 1;transform: none}.nurva .reveal-stagger > *{opacity: 0;transform: translateY(24px);transition: opacity 0.75s var(--ease),transform 0.75s var(--ease)}.nurva .reveal-stagger.is-in > *{opacity: 1;transform: none}.nurva .reveal-stagger.is-in > *:nth-child(1){transition-delay: 0.05s}.nurva .reveal-stagger.is-in > *:nth-child(2){transition-delay: 0.14s}.nurva .reveal-stagger.is-in > *:nth-child(3){transition-delay: 0.23s}.nurva .reveal-stagger.is-in > *:nth-child(4){transition-delay: 0.32s}.nurva .reveal-stagger.is-in > *:nth-child(5){transition-delay: 0.41s}.nurva .reveal-stagger.is-in > *:nth-child(6){transition-delay: 0.5s}.nurva .empty-state{text-align: center;padding-block: clamp(50px,9vw,110px);--stack: 20px}.nurva .pagination{display: flex;justify-content: center;gap: 8px;margin-top: 50px}.nurva .pagination a,.nurva .pagination span{display: grid;place-items: center;min-width: 42px;height: 42px;padding-inline: 12px;border-radius: var(--radius-pill);border: 1px solid var(--line);font-family: var(--font-brand);font-size: 0.85rem;transition: border-color 0.3s var(--ease),background 0.3s var(--ease)}.nurva .pagination a:hover{border-color: var(--teal)}.nurva .pagination [aria-current="page"]{background: var(--teal);border-color: var(--teal);color: #fff}@media (prefers-reduced-motion: reduce){.nurva{scroll-behavior: auto}.nurva,.nurva *,.nur