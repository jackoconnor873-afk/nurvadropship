<div class="nurva">
  <section class="section" id="nurva-reviews">
    <div class="wrap wrap--wide">
      <div class="sec-head sec-head--split" data-reveal>
        <div class="stack">
          <span class="eyebrow">Real users</span>
          <h2 class="h2">What happens when you stop fighting for air</h2>
        </div>
        <div class="stack" style="--stack:8px">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <span class="muted" style="font-size:.86rem">4.8 average from 2,400+ verified reviews</span>
        </div>
      </div>

      <div class="quotes" data-reveal>
        <figure class="quote stack">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <blockquote class="quote__text">First run where I wasn't gasping through my mouth by kilometre three. Stayed put for the whole 21k, sweat and all.</blockquote>
          <figcaption class="quote__who">
            <span class="quote__avatar">M</span>
            <span><span class="quote__name">Marcus T.</span><br><span class="quote__meta">Verified buyer · Half marathon</span></span>
          </figcaption>
        </figure>

        <figure class="quote stack">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <blockquote class="quote__text">My partner stopped elbowing me at 2am. That alone was worth it. Now I use one every single night.</blockquote>
          <figcaption class="quote__who">
            <span class="quote__avatar">P</span>
            <span><span class="quote__name">Priya R.</span><br><span class="quote__meta">Verified buyer · Nightly user</span></span>
          </figcaption>
        </figure>

        <figure class="quote stack">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <blockquote class="quote__text">I've used the big drug-store brand for years. These hold twice as long and don't curl at the edges when I sweat.</blockquote>
          <figcaption class="quote__who">
            <span class="quote__avatar">D</span>
            <span><span class="quote__name">Danny K.</span><br><span class="quote__meta">Verified buyer · CrossFit</span></span>
          </figcaption>
        </figure>

        <figure class="quote stack">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;</div>
          <blockquote class="quote__text">Deviated septum since I was 19. Not a cure, but the first thing that's made a noticeable difference at night.</blockquote>
          <figcaption class="quote__who">
            <span class="quote__avatar">S</span>
            <span><span class="quote__name">Sofia L.</span><br><span class="quote__meta">Verified buyer · Nightly user</span></span>
          </figcaption>
