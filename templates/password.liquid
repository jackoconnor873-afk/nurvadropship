<div class="section" style="min-height:100vh;display:grid;place-items:center">
  <div class="wrap wrap--narrow center stack">
    <span class="eyebrow">Coming soon</span>
    <h1 class="display">{{ shop.name }}</h1>
    <p class="lede" style="margin-inline:auto">Breathe Pure | Live Pure. We're putting the finishing touches on the store — leave your email and we'll tell you the moment it opens.</p>

    {%- form 'storefront_password' -%}
      <div class="signup">
        <label class="visually-hidden" for="Password">Password</label>
        <input type="password" name="password" id="Password" placeholder="Store password">
        <button type="submit" class="btn">Enter</button>
      </div>
      {%- if form.errors -%}<p class="form-error">Wrong password. Try again.</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>
