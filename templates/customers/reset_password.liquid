<div class="section">
  <div class="wrap wrap--narrow stack">
    <div class="sec-head stack"><span class="eyebrow">Account</span><h1 class="h1">Reset password</h1></div>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="stack">
        <div class="stack" style="--stack:8px">
          <label class="opt__label" for="ResetPassword">New password</label>
          <input class="signup-input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password">
        </div>
        <div class="stack" style="--stack:8px">
          <label class="opt__label" for="ResetConfirm">Confirm password</label>
          <input class="signup-input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password">
        </div>
        <button type="submit" class="btn">Reset password</button>
      </div>
    {%- endform -%}
  </div>
</div>
